# 进入网关页所需的访问令牌（务必修改）
TOKEN=please-change-this-token

# 宿主机映射端口（浏览器访问用的端口）
GATE_PORT=8080

# 排查用：true 会在 docker logs 打印「实际转发路径 + 上游状态码」，
# 并在响应里加 X-Gate-Outgoing / X-Gate-Upstream 头（DevTools 直接可见）
# PROXY_LOG=true

# 通用子路径代理：静态资源在根路径 404 时自动探测目标真实前缀（默认开）
# AUTO_SUBPATH=true
# PROBE_TIMEOUT_MS=1200

# 代理模式（登录时还可临时切换）：
#   TRANSPARENT=true     透明代理（nginx 风格，零改写）——推荐
#   PORT_FORWARD=true    端口转发（另开专属端口；https 目标可能混合内容）
# TRANSPARENT=true
# PORT_FORWARD=true
# PORT_FORWARD_START=20000
# PORT_FORWARD_END=20999
# PORT_FORWARD_HOST=          # 留空则用浏览器当前主机名

# 前面套 CDN 时保持默认即可（所有响应禁止共享缓存，防止 404 被缓存固化）
# CACHE_CONTROL=private, no-store, max-age=0, must-revalidate
# BUST_CDN_CACHE=true
