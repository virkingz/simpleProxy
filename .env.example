# 进入网关页所需的访问令牌（务必修改）
TOKEN=please-change-this-token

# 宿主机映射端口（浏览器访问用的端口）
GATE_PORT=8080

# 排查用：true 会在 docker logs 打印「实际转发路径 + 上游状态码」，
# 并在响应里加 X-Gate-Outgoing / X-Gate-Upstream 头（DevTools 直接可见）
# PROXY_LOG=true

# Token 防爆破：连续失败达该次数后指数退避（返回 429 + Retry-After）
# AUTH_MAX_FAILS=5

# 会话 Cookie 的 Secure 策略：auto（仅 HTTPS 请求加，默认）/ true（恒加）
# 仅当你的部署「只通过 HTTPS 访问」时才设 true；同时保留 HTTP 直连入口时设 true 会导致无法登录
# COOKIE_SECURE=auto

# 导航模式：无 Token 的人也能进页面，输入地址后由浏览器直接跳转（不做代理）
# NAVIGATE_ENABLED=true

# 导航是否允许跳转到公网地址。默认 false＝仅内网/私有地址（防开放重定向钓鱼跳板）
# NAVIGATE_ALLOW_PUBLIC=false

# 是否记录每次导航跳转（时间 / 来源 IP / 目标 URL / User-Agent）
# NAVIGATE_LOG=true

# 前面套 CDN 时保持默认即可（所有响应禁止共享缓存，防止 404 被缓存固化）
# CACHE_CONTROL=private, no-store, max-age=0, must-revalidate
